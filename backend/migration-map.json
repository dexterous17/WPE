{
  "meta": {
    "description": "PHP/Symfony → Node (Express) /api/v1 migration tracker. Regenerate route inventory with: docker compose exec web php bin/console debug:router --format=json",
    "symfony_proxy": "/api/symfony/* forwards remaining browser AJAX until migrated",
    "v1_prefix": "/api/v1"
  },
  "phases": [
    {
      "id": 1,
      "name": "public_read_json",
      "note": "No session; DB read-only or static files"
    },
    {
      "id": 2,
      "name": "datatables_read_json",
      "note": "POST form bodies; match JMS/DataTables JSON shape"
    },
    {
      "id": 3,
      "name": "session_mutations",
      "note": "Needs auth (ROLE_USER). Options: JWT, session table, or keep Symfony until BFF session bridge exists"
    },
    {
      "id": 4,
      "name": "html_ssr",
      "note": "Twig pages → React/SSR; out of scope for Express-only pass"
    }
  ],
  "routes": [
    {
      "name": "parliament_members",
      "symfony_path": "/parliament/members",
      "methods": ["GET", "POST"],
      "controller": "App\\Controller\\DefaultController::parliamentMembersAction",
      "consumers": ["public/assets/js/apps.js"],
      "phase": 1,
      "status": "done",
      "node_path": "/api/v1/parliament/members"
    },
    {
      "name": "user_ai_get_personas",
      "symfony_path": "/user/ai/personas",
      "methods": ["GET"],
      "controller": "App\\Controller\\AiAssistantController::getPersonasAction",
      "consumers": [],
      "phase": 1,
      "status": "done",
      "node_path": "/api/v1/ai/personas"
    },
    {
      "name": "assembly_search",
      "symfony_path": "/assembly/search",
      "methods": ["POST"],
      "controller": "App\\Controller\\DefaultController::assemblySearchAction",
      "consumers": ["public/assets/js/apps.js"],
      "phase": 2,
      "status": "done",
      "node_path": "/api/v1/assembly/search"
    },
    {
      "name": "category_type_search",
      "symfony_path": "/{type}/{id}/{slug}/ajax",
      "methods": ["GET", "POST"],
      "controller": "App\\Controller\\CategoryController::listCategorySearchAction",
      "consumers": ["public/assets/js/apps.js"],
      "phase": 2,
      "status": "todo",
      "node_path": null,
      "notes": "Uses InitiativeRepository::searchCategoryType + countAllTypeInitiatives; port SQL/DQL next"
    },
    {
      "name": "user_favourite",
      "symfony_path": "/user/favourite/{id}",
      "methods": ["GET"],
      "controller": "App\\Controller\\UserController::favouriteInitiativeAction",
      "consumers": ["public/assets/js/apps.js"],
      "phase": 3,
      "status": "proxy",
      "node_path": null,
      "notes": "Doctrine Favourite + ROLE_USER; needs session or token strategy"
    },
    {
      "name": "user_friend",
      "symfony_path": "/user/friend/{id}",
      "methods": ["GET"],
      "controller": "App\\Controller\\UserController::favouriteFriendAction",
      "consumers": ["public/assets/js/apps.js"],
      "phase": 3,
      "status": "proxy",
      "node_path": null
    },
    {
      "name": "user_ai_draft",
      "symfony_path": "/user/ai/draft",
      "methods": ["POST"],
      "controller": "App\\Controller\\AiAssistantController::draftAction",
      "consumers": ["templates/User/new.html.twig"],
      "phase": 3,
      "status": "proxy",
      "node_path": null,
      "notes": "GEMINI / HTTP client + secrets; move after personas pattern proven"
    },
    {
      "name": "initiative_show_vote",
      "symfony_path": "/initiative/{id}/{slug}/vote",

      "status": "todo",
      "node_path": null
    },
    {
      "name": "admin_initiative_search",
      "symfony_path": "/admin/initiative/search",
      "methods": ["GET", "POST"],
      "controller": "App\\Controller\\Admin\\InitiativeAdminController",
      "consumers": [],
      "phase": 3,
      "status": "todo",
      "node_path": null
    }
  ],
  "jquery_ajax_symfony_proxy": {
    "files": [
      "public/assets/js/vote.js",
      "public/assets/js/comment.js",
      "public/assets/js/apps.js",
      "templates/User/new.html.twig",
      "templates/Delegation/edit.html.twig",
      "templates/User/avatar.html.twig"
    ],
    "note": "Uses wpeSymfonyProxyUrl() until switched to wpeApiV1Url()"
  },
  "comment_forms": {
    "note": "comment.js uses form action/href from Twig-rendered URLs (not FOS expose); migrate with explicit /api/v1/comment/* routes"
  },
  "react": {
    "path": "frontend/",
    "note": "Vite proxy /api → Node; prefer /api/v1 for new calls"
  }
}
